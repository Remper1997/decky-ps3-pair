{
  "name": "decky-ps3-pair",
  "version": "1.2.1",
  "description": "Use PS3 (DualShock 3) controllers on the Steam Deck: keep pairings across SteamOS updates, LEDs, battery, rumble",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Remper1997/decky-ps3-pair.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "ps3",
    "dualshock3",
    "bluetooth"
  ],
  "author": "Remper97",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/Remper1997/decky-ps3-pair/issues"
  },
  "homepage": "https://github.com/Remper1997/decky-ps3-pair#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "rollup": "^4.53.3",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "@rollup/rollup-linux-x64-musl": "^4.53.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
